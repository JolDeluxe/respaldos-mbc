# ============================================================
# mbc-backup-service - variables de entorno
# Copie este archivo a ".env" (NUNCA lo suba a Git) y ajuste los valores.
# ============================================================

# --- Modo de ejecución -----------------------------------------------------
# development: NO se conecta a MySQL ni escribe en BACKUP_ROOT salvo MBC_ALLOW_LIVE=true.
# production : modo servidor (lo establece ecosystem.config.cjs bajo PM2).
MBC_MODE=development
MBC_ALLOW_LIVE=false
# El programador diario solo corre si es true (en producción lo fija PM2).
ENABLE_SCHEDULER=false

# --- Rutas -------------------------------------------------------------------
# En desarrollo se utiliza por defecto la carpeta local del proyecto (.local-backups).
# En producción (Windows Server) configure la ruta definitiva:
# BACKUP_ROOT=C:\Servidor\BasesDatos\Respaldos\Diarios
BACKUP_ROOT=.local-backups
SQLITE3_PATH=C:\Servidor\Herramientas\SQLite\sqlite3.exe
# En producción apunte al mysqldump 8.4 de la instalación del servidor, p. ej.:
# MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.4\bin\mysqldump.exe
MYSQLDUMP_PATH=mysqldump
RUNTIME_DIR=runtime
CONFIG_PATH=config/databases.json

# --- Programación ------------------------------------------------------------
CRON_EXPRESSION=59 23 * * *
TIMEZONE=America/Mexico_City
RETENTION_COUNT=15
RECOVERY_ENABLED=true
RECOVERY_DELAY_SECONDS=120

# --- Recursos ------------------------------------------------------------------
# Reserva mínima de espacio libre en el volumen de respaldos (GB).
MIN_FREE_GB=10
# GZIP 1-9 (4 = moderado, bajo consumo de CPU).
GZIP_LEVEL=4
TOOL_TIMEOUT_MINUTES=360
SHUTDOWN_GRACE_SECONDS=90
LOCK_STALE_MINUTES=10
TEMP_MAX_AGE_HOURS=1
RUN_HISTORY_KEEP=60

# --- Logs --------------------------------------------------------------------
LOG_LEVEL=info
LOG_MAX_MB=10
LOG_MAX_FILES=10
LOG_TO_CONSOLE=false

# --- Contraseñas (referenciadas por "passwordEnv" en config/databases.json) -----
# Defina aquí la contraseña de la cuenta mbc_backup (solo en el .env del servidor).
MYSQL_PRINCIPAL_PASSWORD=
