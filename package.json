{
  "name": "mbc-backup-service",
  "version": "1.0.0",
  "description": "Servicio centralizado de respaldos automáticos (MySQL + SQLite) para Windows Server con PM2",
  "main": "dist/index.js",
  "scripts": {
    "test": "node --import tsx --test --test-reporter=spec tests/*.test.ts",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "validate-config": "node dist/cli/index.js validate-config",
    "tools": "node dist/cli/index.js tools",
    "backup:dry-run": "node dist/cli/index.js dry-run",
    "backup:run": "node dist/cli/index.js run",
    "backup:verify": "node dist/cli/index.js verify",
    "health-check": "node dist/cli/index.js health-check",
    "cli:dev": "tsx src/cli/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "dotenv": "^18.0.10",
    "mysql2": "^3.24.6",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23 || >=26.0.0"
  },
  "private": "true"
}
